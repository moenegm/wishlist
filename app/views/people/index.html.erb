<% content_for :title, "People · Wishwell" %>
<section class="page-section">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
      <p class="eyebrow">Good ideas are better shared</p>
      <h1 class="page-title">People &amp; wishes</h1>
      <p class="page-subtitle mb-0">Follow people to keep their public wishlists close for birthdays, holidays, and just-because days.</p>
    </div>
  </div>

  <%= form_with url: people_path, method: :get, class: "people-search mb-5" do |form| %>
    <%= form.label :q, "Find someone", class: "visually-hidden" %>
    <%= form.search_field :q, value: @query, class: "form-control", placeholder: "Search by first or last name" %>
    <%= form.submit "Search", class: "btn btn-dark" %>
  <% end %>

  <% if @query.present? %>
    <div class="d-flex justify-content-between align-items-end gap-3 mb-3">
      <div><p class="eyebrow mb-1">PUBLIC PROFILES</p><h2 class="h3 mb-0">Search results</h2></div>
      <%= link_to "Clear search", people_path, class: "small text-decoration-none" %>
    </div>
    <% if @people.any? %>
      <div class="row g-3 mb-5"><%= render partial: "person_card", collection: @people, as: :person %></div>
    <% else %>
      <div class="empty-state p-4 mb-5"><h2 class="h5">No public profiles found</h2><p class="text-muted mb-0">Try another name. People appear here when they share at least one wishlist.</p></div>
    <% end %>
  <% end %>

  <div class="mb-5">
    <div class="mb-3"><p class="eyebrow mb-1">YOUR CIRCLE</p><h2 class="h3 mb-0">From people you follow</h2></div>
    <% followed_lists = @following.index_with { |person| person.wlists.select(&:is_public?) }.reject { |_person, lists| lists.empty? } %>
    <% if followed_lists.any? %>
      <div class="row g-3">
        <% followed_lists.each do |person, public_lists| %>
          <div class="col-12 col-lg-6">
            <article class="card border-0 p-4 h-100">
              <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div><p class="eyebrow mb-1"><%= [person.first_name, person.last_name].compact_blank.join(" ").presence || "Wishwell member" %></p><h3 class="h5 mb-0"><%= link_to "See their profile", person, class: "text-decoration-none text-dark" %></h3></div>
                <% follow = current_user.follows_as_follower.find_by!(followed_user: person) %>
                <%= button_to "Following", follow_path(follow), method: :delete, class: "btn btn-outline-dark btn-sm" %>
              </div>
              <div class="followed-lists">
                <% public_lists.each do |wlist| %>
                  <%= link_to wlist, class: "followed-list-link" do %>
                    <span><strong><%= wlist.title %></strong><small><%= wlist.wl_category.presence || "Wishlist" %> · <%= pluralize(wlist.wishes.size, "wish") %></small></span>
                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                  <% end %>
                <% end %>
              </div>
            </article>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state p-4 p-md-5">
        <span class="empty-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
        <h3 class="h5">Your circle starts with a follow</h3>
        <p class="text-muted mb-0">Search for someone above, then follow them to keep their public lists handy.</p>
      </div>
    <% end %>
  </div>

  <% unless @query.present? %>
    <div class="d-flex justify-content-between align-items-end gap-3 mb-3"><div><p class="eyebrow mb-1">A LITTLE INSPIRATION</p><h2 class="h3 mb-0">People sharing lists</h2></div></div>
    <% if @people.any? %>
      <div class="row g-3"><%= render partial: "person_card", collection: @people, as: :person %></div>
    <% else %>
      <div class="empty-state p-4"><h2 class="h5">No public lists yet</h2><p class="text-muted mb-0">When someone shares a list, their profile will appear here.</p></div>
    <% end %>
  <% end %>
</section>
