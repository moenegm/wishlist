<% like = current_user&.likes&.find_by(likeable: item) %>
<div class="social-actions" aria-label="Reactions and comments">
  <% if user_signed_in? %>
    <% if like %>
      <%= button_to like_path(like), method: :delete, class: "social-action is-liked", aria: { label: "Unlike" }, title: "Unlike" do %><i class="bi bi-heart-fill" aria-hidden="true"></i><span><%= item.likes.size %></span><% end %>
    <% else %>
      <%= button_to likes_path(likeable_type: item.class.name, likeable_id: item.id), method: :post, class: "social-action", aria: { label: "Like" }, title: "Like" do %><i class="bi bi-heart" aria-hidden="true"></i><span><%= item.likes.size %></span><% end %>
    <% end %>
  <% else %>
    <%= link_to new_user_session_path, class: "social-action", aria: { label: "Sign in to like" }, title: "Sign in to like" do %><i class="bi bi-heart" aria-hidden="true"></i><span><%= item.likes.size %></span><% end %>
  <% end %>

  <%= render "shared/comment_thread", item: item %>
</div>
