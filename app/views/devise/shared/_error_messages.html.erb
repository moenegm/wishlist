<% if resource.errors.any? %>
  <div class="form-errors p-3 mb-4" role="alert" aria-live="polite">
    <p class="fw-semibold mb-2">Please check the following:</p>
    <ul class="mb-0">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
    <% if resource.errors.details.fetch(:email, []).any? { |error| error[:error] == :taken } %>
      <p class="mt-3 mb-0">This email already has an account. <%= link_to "Sign in", new_session_path(resource_name) %> or <%= link_to "reset your password", new_password_path(resource_name) %>.</p>
    <% end %>
  </div>
<% end %>
