<% content_for :title, "Sign in · Wishwell" %>
<section class="auth-card card border-0">
  <span class="brand-mark mb-4"><i class="bi bi-heart-fill" aria-hidden="true"></i></span>
  <p class="eyebrow">Good to see you again</p>
  <h1 class="page-title">Welcome back</h1>
  <p class="page-subtitle mb-4">Sign in to pick up where your wishes left off.</p>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="mb-3">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", required: true %>
    </div>
    <div class="mb-3">
      <%= f.label :password, class: "form-label" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "form-control", required: true %>
    </div>
    <% if devise_mapping.rememberable? %>
      <div class="form-check mb-4"><%= f.check_box :remember_me, class: "form-check-input" %><%= f.label :remember_me, class: "form-check-label" %></div>
    <% end %>
    <div class="d-grid"><%= f.submit "Sign in", class: "btn btn-dark btn-lg" %></div>
  <% end %>
  <div class="border-top mt-4 pt-3"><%= render "devise/shared/links" %></div>
</section>
