<% content_for :title, "Reset your password · Wishwell" %>
<section class="auth-card card border-0">
  <span class="brand-mark mb-4"><i class="bi bi-key" aria-hidden="true"></i></span>
  <p class="eyebrow">We’ll help you get back in</p>
  <h1 class="page-title">Reset your password</h1>
  <p class="page-subtitle mb-4">Enter your account email and we’ll send a reset link.</p>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="mb-4"><%= f.label :email, class: "form-label" %><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", required: true %></div>
    <div class="d-grid"><%= f.submit "Send reset link", class: "btn btn-dark btn-lg" %></div>
  <% end %>
  <div class="border-top mt-4 pt-3"><%= render "devise/shared/links" %></div>
</section>
