<% content_for :title, "Choose a new password · Wishwell" %>
<section class="auth-card card border-0">
  <span class="brand-mark mb-4"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
  <p class="eyebrow">Almost there</p>
  <h1 class="page-title">Choose a new password</h1>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>
    <div class="mb-3">
      <%= f.label :password, "New password", class: "form-label" %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control", required: true %>
      <% if @minimum_password_length %><p class="form-hint mb-0"><%= @minimum_password_length %> characters minimum</p><% end %>
    </div>
    <div class="mb-4"><%= f.label :password_confirmation, "Confirm new password", class: "form-label" %><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", required: true %></div>
    <div class="d-grid"><%= f.submit "Save new password", class: "btn btn-dark btn-lg" %></div>
  <% end %>
  <div class="border-top mt-4 pt-3"><%= render "devise/shared/links" %></div>
</section>
