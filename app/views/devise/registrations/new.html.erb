<% content_for :title, "Create an account · Wishwell" %>
<div class="auth-layout">
  <%= render "devise/shared/welcome_panel" %>
<section class="auth-card card border-0">
  <span class="brand-mark mb-4"><i class="bi bi-heart-fill" aria-hidden="true"></i></span>
  <p class="eyebrow">A little space for what you want</p>
  <h1 class="page-title">Make it yours</h1>
  <p class="page-subtitle mb-4">Start a wishlist and keep the things you’re looking forward to close by.</p>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="row g-3 mb-3">
      <div class="col-sm-6"><%= f.label :first_name, class: "form-label" %><%= f.text_field :first_name, autofocus: true, autocomplete: "given-name", class: "form-control", required: true %></div>
      <div class="col-sm-6"><%= f.label :last_name, class: "form-label" %><%= f.text_field :last_name, autocomplete: "family-name", class: "form-control" %></div>
    </div>
    <div class="mb-3"><%= f.label :email, class: "form-label" %><%= f.email_field :email, autocomplete: "email", class: "form-control", required: true %></div>
    <div class="mb-3">
      <%= f.label :password, class: "form-label" %>
      <%= f.password_field :password, autocomplete: "new-password", class: "form-control", required: true %>
      <% if @minimum_password_length %><p class="form-hint mb-0"><%= @minimum_password_length %> characters minimum</p><% end %>
    </div>
    <div class="mb-3"><%= f.label :password_confirmation, "Confirm password", class: "form-label" %><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", required: true %></div>
    <div class="mb-4"><%= f.label :avatar, "Profile photo (optional)", class: "form-label" %><%= f.file_field :avatar, class: "form-control", accept: "image/*" %></div>
    <div class="d-grid"><%= f.submit "Create account", class: "btn btn-dark btn-lg" %></div>
  <% end %>

  <div class="border-top mt-4 pt-3"><%= render "devise/shared/links" %></div>
</section>
</div>
