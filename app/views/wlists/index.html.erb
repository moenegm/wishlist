<% content_for :title, "Your wishlists · Wishwell" %>
<section class="page-section">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-5">
    <div>
      <p class="eyebrow">Gather what you’re dreaming of</p>
      <h1 class="page-title">Your wishlists</h1>
      <p class="page-subtitle mb-0">One place for every idea, occasion, and maybe-someday.</p>
    </div>
    <%= link_to "New wishlist", new_wlist_path, class: "btn btn-dark" %>
  </div>

  <% if @wlists.any? %>
    <div class="row g-3">
      <% @wlists.each do |wlist| %>
        <div class="col-12 col-md-6 col-lg-4"><%= render "wlist_card", wlist: wlist %></div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state p-4 p-md-5">
      <span class="empty-icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
      <h2 class="h4">Your first list starts here</h2>
      <p class="text-muted mb-4">Create a wishlist for a special day, a home project, or all the little things you love.</p>
      <%= link_to "Create your first wishlist", new_wlist_path, class: "btn btn-dark" %>
    </div>
  <% end %>
</section>
