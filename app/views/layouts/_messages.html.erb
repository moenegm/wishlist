<% flash.each do |key, value| %>
  <% style = { "notice" => "success", "alert" => "danger" }.fetch(key.to_s, "info") %>
  <div class="alert alert-<%= style %> alert-dismissible fade show mt-3 mb-0" role="alert">
    <%= value %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
  </div>
<% end %>
