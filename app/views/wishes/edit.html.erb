<% content_for :title, "Edit #{@wish.title} · Wishwell" %>
<section class="page-section">
  <p class="eyebrow">Still on your mind?</p>
  <h1 class="page-title">Edit your wish</h1>
  <p class="page-subtitle mb-4">Change any details or move it to another wishlist.</p>
  <div class="card border-0 p-4 p-md-5" style="max-width: 720px">
    <%= render "form", wish: @wish %>
  </div>
</section>
