<% content_for :title, "Your wishes · Wishwell" %>
<section class="page-section">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-5">
    <div>
      <p class="eyebrow">Little things to look forward to</p>
      <h1 class="page-title">Your wishes</h1>
      <p class="page-subtitle mb-0">All the things you’ve saved, together in one place.</p>
    </div>
    <%= link_to "Add a wish", new_wish_path, class: "btn btn-dark" %>
  </div>

  <% if @wishes.any? %>
    <div class="row g-3">
      <% @wishes.each do |wish| %>
        <div class="col-12 col-md-6 col-lg-4">
          <article class="card h-100 border-0 p-4">
            <div class="brand-mark mb-4"><i class="bi bi-heart" aria-hidden="true"></i></div>
            <h2 class="h4 mb-2"><%= link_to wish.title, wish, class: "text-decoration-none text-dark" %></h2>
            <p class="small text-muted mb-3"><%= link_to wish.wlist.title, wish.wlist, class: "link-secondary" %></p>
            <% if wish.location.present? %><p class="mb-2"><i class="bi bi-geo-alt me-2 text-muted" aria-hidden="true"></i><%= wish.location %></p><% end %>
            <div class="d-flex justify-content-between align-items-center mt-auto pt-3">
              <span class="fw-semibold"><%= number_to_currency(wish.price) if wish.price.present? %></span>
              <%= link_to "View wish", wish, class: "small fw-semibold text-decoration-none" %>
            </div>
          </article>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state p-4 p-md-5">
      <span class="empty-icon"><i class="bi bi-heart" aria-hidden="true"></i></span>
      <h2 class="h4">Save the things you love</h2>
      <p class="text-muted mb-4">Add a wish to one of your lists so you can find it when the time is right.</p>
      <% if current_user.wlists.any? %>
        <%= link_to "Add your first wish", new_wish_path, class: "btn btn-dark" %>
      <% else %>
        <%= link_to "Create a wishlist", new_wlist_path, class: "btn btn-dark" %>
      <% end %>
    </div>
  <% end %>
</section>
